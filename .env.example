# --- Base de datos (Fase 1) ---
# Con el docker-compose incluido funciona tal cual. En un VPS, cambiá usuario, clave y host.
DATABASE_URL="postgresql://runa:runa_dev_pass@localhost:5432/runa_sport"

# --- Administrador inicial (lo crea `npm run db:seed`) ---
# Usá una clave larga (10+ caracteres). Después de entrar por primera vez, cambiala desde el panel.
ADMIN_EMAIL="admin@runasport.com.ar"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""

# --- Recuperar contraseña por email (Fase 4) ---
# URL pública del sitio: se usa para armar el enlace del email. En producción: https://tudominio.com
APP_URL="http://localhost:3000"
# Datos de tu casilla SMTP (Gmail con clave de aplicación, Brevo, Resend, etc.).
# Si SMTP_HOST queda vacío, el enlace de recuperación se imprime en la terminal de `npm run dev`.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Runa Sport <no-reply@runasport.com.ar>"

# --- Todavía no se usan ---
# STORAGE_DRIVER="local"    # local | cloudinary | s3 (hoy las imágenes van a public/uploads)
# CLOUDINARY_URL=""
